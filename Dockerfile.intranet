# Base stage with common dependencies
FROM python:3.11-slim AS base
SHELL ["/bin/bash", "-c"]

# Set environment variables to make Python print directly to the terminal and avoid .pyc files.
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies required for package manager and build tools.
# sudo, wget, zip needed for some assistants, like junie
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    git \
    ssh \
    sudo \
    wget \
    zip \
    unzip \
    sed \
    && rm -rf /var/lib/apt/lists/*

# Install pipx.
RUN python3 -m pip install --no-cache-dir pipx \
    && pipx ensurepath

# ---------------------------------------------------------------------------
# Node.js (official registry is used during build — npm language servers are
# pre-downloaded.  The registry can be overridden at RUNTIME via the
# NPM_REGISTRY environment variable — see docker-entrypoint.sh).
# ---------------------------------------------------------------------------
ENV NVM_VERSION=0.40.3
ENV NODE_VERSION=22.18.0
RUN set -o pipefail \
    && curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v${NVM_VERSION}/install.sh | bash
# standard location
ENV NVM_DIR=/root/.nvm
RUN . "$NVM_DIR/nvm.sh" && nvm install ${NODE_VERSION}
RUN . "$NVM_DIR/nvm.sh" && nvm use v${NODE_VERSION}
RUN . "$NVM_DIR/nvm.sh" && nvm alias default v${NODE_VERSION}
ENV PATH="${NVM_DIR}/versions/node/v${NODE_VERSION}/bin/:${PATH}"

# Add local bin to the path
ENV PATH="${PATH}:/root/.local/bin"

# Install the latest version of uv
RUN set -o pipefail \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && uv --version

# Install Rust and rustup for rust-analyzer support (minimal profile)
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="${CARGO_HOME}/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    --default-toolchain stable \
    --profile minimal \
    && rustup component add rust-analyzer

# ---------------------------------------------------------------------------
# Java / Maven — required for Java, Kotlin, Scala, Groovy, BSL support
# JDK 21 (headless) + Maven 3.9
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-21-jdk-headless \
    maven \
    && rm -rf /var/lib/apt/lists/*
ENV JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Set the working directory
WORKDIR /workspaces/serena

# Copy all files for development
COPY . /workspaces/serena/

# Create Serena configuration
ENV SERENA_HOME=/workspaces/serena/config
RUN mkdir -p $SERENA_HOME
RUN cp src/serena/resources/serena_config.template.yml $SERENA_HOME/serena_config.yml
RUN sed -i 's/^gui_log_window: .*/gui_log_window: False/' $SERENA_HOME/serena_config.yml
RUN sed -i 's/^web_dashboard_listen_address: .*/web_dashboard_listen_address: 0.0.0.0/' $SERENA_HOME/serena_config.yml
RUN sed -i 's/^web_dashboard_open_on_launch: .*/web_dashboard_open_on_launch: False/' $SERENA_HOME/serena_config.yml

# Create virtual environment and install dependencies
RUN uv venv
RUN . .venv/bin/activate
RUN uv pip install -r pyproject.toml -e .
ENV PATH="/workspaces/serena/.venv/bin:${PATH}"

# ---------------------------------------------------------------------------
# Pre-download Java LSP server dependencies (Gradle, vscode-java VSIX,
# IntelliCode) during image build so that no external network access is
# required at container startup.  The skip-if-exists logic in
# eclipse_jdtls.py will detect these files and skip the downloads.
#
# NOTE: If you only need non-Java language servers, comment out this block
# to save ~500 MB of image size and reduce build time.
# ---------------------------------------------------------------------------
RUN set -euo pipefail && \
    LS_DIR="$SERENA_HOME/language_servers/static/EclipseJDTLS" && \
    mkdir -p "$LS_DIR" && \
    \
    download_and_verify() { \
        local url="$1" dest="$2" expected_sha256="$3"; \
        echo "[build] Downloading $url ..." && \
        curl --fail --location --output "$dest" "$url" && \
        actual=$(sha256sum "$dest" | awk '{print $1}') && \
        if [ "$actual" != "$expected_sha256" ]; then \
            echo "SHA256 mismatch: expected $expected_sha256, got $actual" >&2; \
            rm -f "$dest"; exit 1; \
        fi && \
        echo "[build] Saved to $dest"; \
    } && \
    extract_zip() { \
        local zip_path="$1" dest_dir="$2"; \
        echo "[build] Extracting $zip_path -> $dest_dir ..." && \
        mkdir -p "$dest_dir" && \
        unzip -qo "$zip_path" -d "$dest_dir" && \
        rm -f "$zip_path"; \
    } && \
    \
    # --- Gradle 8.14.2 --- \
    gradle_ver="8.14.2" && \
    gradle_dir="$LS_DIR/gradle-${gradle_ver}" && \
    if [ -d "$gradle_dir" ]; then \
        echo "[build] Gradle already exists, skipping"; \
    else \
        download_and_verify \
            "https://services.gradle.org/distributions/gradle-${gradle_ver}-bin.zip" \
            "$LS_DIR/gradle-${gradle_ver}.zip" \
            "7197a12f450794931532469d4ff21a59ea2c1cd59a3ec3f89c035c3c420a6999" && \
        extract_zip "$LS_DIR/gradle-${gradle_ver}.zip" "$(dirname "$gradle_dir")"; \
    fi && \
    \
    # --- vscode-java VSIX 1.54.0-923 (linux-x64) --- \
    vj_ver="1.54.0-923" && \
    vj_tag="v${vj_ver%%-*}" && \
    vj_dirname="vscode-java-${vj_ver}" && \
    vj_dir="$LS_DIR/$vj_dirname" && \
    lombok_jar="$vj_dir/extension/lombok/lombok-1.18.39-4050.jar" && \
    if [ -f "$lombok_jar" ]; then \
        echo "[build] vscode-java already exists, skipping"; \
    else \
        download_and_verify \
            "https://github.com/redhat-developer/vscode-java/releases/download/${vj_tag}/java-linux-x64-${vj_ver}.vsix" \
            "$LS_DIR/${vj_dirname}.vsix" \
            "9d4b15da54e25a0192f9bac073f086c015397d3676623b68dbf83a5dbaf5132b" && \
        extract_zip "$LS_DIR/${vj_dirname}.vsix" "$vj_dir"; \
    fi && \
    \
    # --- IntelliCode 1.2.30 (optional, non-fatal) --- \
    # NOTE: version 1.2.30 == INITIAL_INTELLICODE_VERSION, so the runtime uses
    # the legacy unversioned directory name "intellicode" (no version suffix).
    ic_ver="1.2.30" && \
    ic_dirname="intellicode" && \
    ic_dir="$LS_DIR/$ic_dirname" && \
    ic_jar="$ic_dir/extension/dist/com.microsoft.jdtls.intellicode.core-0.7.0.jar" && \
    ic_members="$ic_dir/extension/dist/bundledModels/java_intellisense-members" && \
    if [ -f "$ic_jar" ] && [ -f "$ic_members" ]; then \
        echo "[build] IntelliCode already exists, skipping"; \
    else \
        if download_and_verify \
            "https://VisualStudioExptTeam.gallery.vsassets.io/_apis/public/gallery/publisher/VisualStudioExptTeam/extension/vscodeintellicode/${ic_ver}/assetbyname/Microsoft.VisualStudio.Services.VSIXPackage" \
            "$LS_DIR/${ic_dirname}.vsix" \
            "7f61a7f96d101cdf230f96821be3fddd8f890ebfefb3695d18beee43004ae251"; then \
            extract_zip "$LS_DIR/${ic_dirname}.vsix" "$ic_dir"; \
        else \
            echo "[build] IntelliCode download failed (non-fatal, optional)"; \
            rm -f "$LS_DIR/${ic_dirname}.vsix"; \
        fi; \
    fi && \
    \
    echo "[build] Java LSP pre-download complete"

# ---------------------------------------------------------------------------
# Production stage — trims down dev-only layers and sets the runtime entrypoint
# ---------------------------------------------------------------------------
FROM base AS production

# Copy the runtime entrypoint script
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

ENTRYPOINT ["/docker-entrypoint.sh"]
